generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARTICIPANT
  ORGANIZER
  ADMIN
  SUPERADMIN
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  slackId       String?  @unique
  hcaId         String?  @unique
  role          Role     @default(PARTICIPANT)

  accounts     Account[]
  sessions     Session[]
  submissions  Submission[]
  votes        Vote[]
  orgs         OrgMember[]
  orders       PassportOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Org {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String?
  apiKey      String?  @unique
  members     OrgMember[]
  orders      PassportOrder[]
  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrgRole {
  OWNER
  ORGANIZER
}

model OrgMember {
  id     String  @id @default(cuid())
  orgId  String
  userId String
  role   OrgRole @default(ORGANIZER)

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
}

model PassportOrder {
  id              String      @id @default(cuid())
  orgId           String
  ysws            String?
  quantity        Int
  status          OrderStatus @default(PENDING)
  note            String?
  createdBy       String
  userId          String?
  recipientName   String?
  recipientEmail  String?

  org  Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([userId])
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  REJECTED
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  orgId       String?
  title       String
  description String?
  url         String?
  image       String?
  status      SubmissionStatus @default(SUBMITTED)
  votes       Vote[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org?  @relation(fields: [orgId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orgId])
}

model Vote {
  id           String @id @default(cuid())
  submissionId String
  userId       String

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([submissionId, userId])
  @@index([userId])
}
