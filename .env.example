# Postgres (local docker-compose)
DATABASE_URL="postgresql://whoami:whoami@localhost:5432/whoami?schema=public"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Hack Club Auth (https://auth.hackclub.com/developer/apps)
AUTH_HCA_CLIENT_ID=""
AUTH_HCA_CLIENT_SECRET=""

# Comma-separated emails that should be treated as superadmins regardless of
# their DB role. Handy for dev testing.
SUPERADMIN_EMAILS=""

# Upstash Redis (feedback widget)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
